<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark status/navigation bars that match the app instead of the default colours. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/oes_night</item>
        <item name="android:statusBarColor">@color/oes_night</item>
        <item name="android:navigationBarColor">@color/oes_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/oes_night</item>
        <item name="android:statusBarColor">@color/oes_night</item>
        <item name="android:navigationBarColor">@color/oes_night</item>
    </style>
</resources>
